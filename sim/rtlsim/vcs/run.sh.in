#!/bin/bash
set -euo pipefail
if [[ $# == 1 && $1 == -h ]]; then
    echo 'Usage: rtlsim <program>'
    exit 0
fi
if [[ $# != 1 || $1 == -* ]]; then
    echo 'Usage: rtlsim <program>' >&2
    exit 2
fi
engine_dir=$(dirname -- "$(readlink -f -- "$0")")
exec "$engine_dir/simv" -exitstatus -assert finish_maxfail=1 +vcs+lic+wait "+program=$1" "+vcd=${VCD_FILE:-trace.vcd}" "+fsdb=${FSDB_FILE:-trace.fsdb}"
